NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/tailo360
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=365d
OTP_TTL_MINUTES=10
# Owner-controlled phone login flow: server uses OTP_PROVIDER below; firebase
# uses the Flutter Firebase Phone Auth SDK and server-side ID-token exchange.
PHONE_AUTH_MODE=server
# OTP provider for production: msg91 (default) or twilio.
OTP_PROVIDER=twilio
# Use provider to send real OTPs locally; use development for the fixed 123456 code.
OTP_DELIVERY_MODE=development
# MSG91 OTP (required when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Twilio Verify (required when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Development only: return the OTP in the API response. Keep false in production.
EXPOSE_DEV_OTP=true
# Development/demo only. Never enable this in production: it exposes the
# fixed demo credentials 9876543210 / 111111.
DEMO_ACCOUNT_ENABLED=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://tailo360.com,https://www.tailo360.com
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15
MAX_FABRIC_PHOTOS_PER_GARMENT=5
# Cloudflare R2 (private bucket; media is served through short-lived signed URLs)
R2_ACCOUNT_ID=
R2_BUCKET=tailo360
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL_SECONDS=900
# Automated encrypted backups. Use a unique 32-byte key encoded as 64 hex
# characters or base64. Store this key outside the database and R2 account.
BACKUP_ENABLED=false
BACKUP_CRON=30 2 * * *
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_PREFIX=system-backups
# Use a separate private bucket so primary-media deletion cannot erase backups.
BACKUP_R2_BUCKET=
# Comma-separated OAuth client IDs for Android, iOS and web.
GOOGLE_CLIENT_IDS=
# The same Web OAuth client ID supplied to Flutter as
# --dart-define=GOOGLE_SERVER_CLIENT_ID=... must be included above.
# Store subscriptions. Define only products actually configured in Play Console/App Store Connect.
GOOGLE_PLAY_PACKAGE_NAME=com.tailo360
GOOGLE_SERVICE_ACCOUNT_JSON=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Use escaped \n characters when storing this PEM in a hosted environment.
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.example.tailo360
APPLE_APP_ID=
APPLE_ENVIRONMENT=sandbox
# Firebase service account JSON for push notifications and verification of
# Firebase Phone Auth ID tokens. Enable Phone sign-in in Firebase Console.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Prefer Base64 on hosting dashboards that escape JSON/PEM characters. When
# supplied, this takes precedence over FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=
